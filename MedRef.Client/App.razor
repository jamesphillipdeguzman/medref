@using Microsoft.AspNetCore.Components.Authorization
@using MedRef.Client.Components

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            @* This remains your "Bouncer" that checks for a profile role status *@
            <RoleGuard>
                <ChildContent>
                    <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                        @* FIX: When a Nurse logs out while sitting on a secure page,
                           this block catches the dropped session and redirects them home
                        *@
                        <NotAuthorized>
                            <RedirectToLogin />
                        </NotAuthorized>
                    </AuthorizeRouteView>
                    <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                </ChildContent>
                <NotAuthorizedContent>
                    <MedRef.Client.Pages.Home />
                </NotAuthorizedContent>
            </RoleGuard>
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>