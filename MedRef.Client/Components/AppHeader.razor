@inject NavigationManager Navigation

@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>

    <AuthorizeView>

        <Authorized>

            <header class="app-header">
                <div class="brand-block">
                    <div class="logo-mark" aria-hidden="true">
                        <span class="logo-cross-h"></span>
                        <span class="logo-cross-v"></span>
                    </div>

                    <span class="app-name">MedRef</span>
                </div>

                <div class="mode-toggle" role="group" aria-label="Mode switch">

                    <span class="mode-label active">
                        Nurse Mode
                    </span>

                    <button class="switch-button on"
                            @onclick="Logout"
                            type="button">
                        <span class="switch-thumb"></span>
                    </button>

                    <span class="mode-label">
                        Patient Mode
                    </span>

                </div>
            </header>

        </Authorized>

        <NotAuthorized>

            <header class="app-header">
                <div class="brand-block">
                    <div class="logo-mark" aria-hidden="true">
                        <span class="logo-cross-h"></span>
                        <span class="logo-cross-v"></span>
                    </div>

                    <span class="app-name">MedRef</span>
                </div>

                <div class="mode-toggle" role="group" aria-label="Mode switch">

                    <span class="mode-label">
                        Nurse Mode
                    </span>

                    <button class="switch-button off"
                            @onclick="Login"
                            type="button">
                        <span class="switch-thumb"></span>
                    </button>

                    <span class="mode-label active">
                        Patient Mode
                    </span>

                </div>
            </header>

        </NotAuthorized>

    </AuthorizeView>

</CascadingAuthenticationState>

@code {

    private void Login()
    {
        Navigation.NavigateTo(
            "authentication/login",
            forceLoad: true);
    }

    private void Logout()
    {
        Navigation.NavigateTo(
            "authentication/logout",
            forceLoad: true);
    }

}