@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<header class="app-header">
    @* --- Left Side: Logo and Branding --- *@
    <div class="brand-block">
        <NavLink class="d-flex align-items-center text-decoration-none" href="" Match="NavLinkMatch.All">
            <div class="logo-mark" aria-hidden="true">
                <span class="logo-cross-h"></span>
                <span class="logo-cross-v"></span>
            </div>
            <span class="app-name">MedRef</span>
        </NavLink>
    </div>

    @* --- Right Side: Dynamic Mode Status Displays --- *@
    <AuthorizeView>
        <Authorized>
            @{
                var isNurse = context.User.IsInRole("Nurse") ||
                              context.User.FindFirst("Role")?.Value == "Nurse" ||
                              context.User.FindFirst(ClaimTypes.Role)?.Value == "Nurse";
            }

            <div class="mode-toggle" role="group" aria-label="Mode status">
                <span class="mode-label @(isNurse ? "active" : "")">
                    Nurse Mode
                </span>

                <button class="switch-button @(isNurse ? "on" : "off")" style="cursor: not-allowed;" type="button"
                        disabled>
                    <span class="switch-thumb"></span>
                </button>

                <span class="mode-label @(!isNurse ? "active" : "")">
                    Patient Mode
                </span>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="mode-toggle" role="group" aria-label="Mode switch">
                <span class="mode-label">Public Mode</span>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</header>