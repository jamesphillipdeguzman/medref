@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<nav class="sidebar-nav">
    
    @* Authentication section to show User greeting and Logout/Login button *@
    <AuthorizeView>
        <Authorized>
            <div class="user-profile-section px-3 py-2 mb-3 border-bottom">
                <p class="text-white mb-1">Welcome, @context.User.Identity?.Name?.Split('@')[0]!</p>
                <NavLink class="btn btn-outline-light btn-sm" href="authentication/logout">
                    Logout
                </NavLink>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="px-3 py-2 mb-3">
                <NavLink class="btn btn-primary btn-sm" href="authentication/login">
                    Sign In
                </NavLink>
            </div>
        </NotAuthorized>
    </AuthorizeView>

    <h2 class="sidebar-title">
        Pages
    </h2>

    <NavLink class="page-link" href="icd10-search">
        ICD-10 Search
    </NavLink>

    <AuthorizeView>
        <Authorized>
            @{
                var isNurse = context.User.IsInRole("Nurse") ||
                              context.User.FindFirst("Role")?.Value == "Nurse" ||
                              context.User.FindFirst(ClaimTypes.Role)?.Value == "Nurse";
            }

            @if (isNurse)
            {
                <NavLink class="page-link" href="saved-records">
                    Saved Records
                </NavLink>
            }
        </Authorized>
    </AuthorizeView>

    <NavLink class="page-link" href="help">
        Help
    </NavLink>
</nav>