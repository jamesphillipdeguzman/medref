@page "/"
@inject NavigationManager Navigation
@inject IWebAssemblyHostEnvironment HostEnvironment
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using System.Security.Claims

@* This component represents the home page of the MedRef application *@
<PageTitle>Home</PageTitle>


<hr class="my-4" style="border-color: rgba(255,255,255,0.1);" />

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">

            <div class="modern-card p-5 mb-4">
                <h1 class="display-4 fw-bold">MedRef</h1>
                <h3 class="mb-3">Medical Reference tool for ICD codes</h3>
                <p class="text-muted lead">
                    Welcome to MedRef, your go-to medical reference tool for ICD codes.
                    Explore and understand ICD codes with a professional, user-friendly platform.
                </p>
            </div>

            <AuthorizeView>
                <NotAuthorized>
                    <div class="modern-card p-4 shadow-sm border">
                        <h4 class="mb-3">Secure Account Sign In</h4>
                        <p class="text-muted">Please log in to manage your saved medical records.</p>

                        <div class="d-flex justify-content-center mt-3">
                            <button class="google-signin-btn" @onclick="TriggerGoogleLogin" type="button">
                                <div class="google-icon-wrapper">
                                    <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg"
                                         alt="Google" />
                                </div>
                                <span class="btn-text">Sign in with Google</span>
                            </button>
                        </div>
                    </div>
                </NotAuthorized>
            </AuthorizeView>

        </div>
    </div>
</div>

<hr class="my-4" style="border-color: rgba(255,255,255,0.1);" />
@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated ?? false)
        {
            var roleClaim = user.FindFirst(c => c.Type == "Role")?.Value
                            ?? user.FindFirst(ClaimTypes.Role)?.Value;

            if (roleClaim == "Unassigned" || string.IsNullOrEmpty(roleClaim))
            {
                Navigation.NavigateTo("/role-selection");
            }
        }
    }

    private void TriggerGoogleLogin()
    {
        Navigation.NavigateTo(AuthUrl("login"), forceLoad: true);
    }

    private void TriggerLogout()
    {
        // FORCE LOAD ensures cookies are thoroughly purged and forces Blazor to restart on the login screen
        Navigation.NavigateTo(AuthUrl("logout"), forceLoad: true);
    }

    private string AuthUrl(string action) => HostEnvironment.IsDevelopment()
        ? $"http://localhost:5035/api/auth/{action}"
        : $"/api/auth/{action}";
}