@page "/"
@inject NavigationManager Navigation
@inject IWebAssemblyHostEnvironment HostEnvironment
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using System.Security.Claims

<PageTitle>Home</PageTitle>

<h1>MedRef - Medical Reference tool for ICD codes</h1>

<p>
    Welcome to MedRef, your go-to medical reference tool for ICD codes. Whether you're a healthcare professional,
    student, or simply interested in learning more about medical coding, MedRef provides a comprehensive and
    user-friendly platform to explore and understand ICD codes.
</p>

<hr class="my-4" style="border-color: rgba(255,255,255,0.1);" />

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center gap-3 align-middle">
            <div class="alert alert-success d-inline-block m-0" role="alert"
                 style="background-color: rgba(25, 135, 84, 0.2); color: #75b798; border: 1px solid #2b593f; padding: 8px 16px;">
                <p style="margin-bottom: 0;">Welcome back, <strong>@context.User.Identity?.Name</strong>!</p>
            </div>

            @* Intuitive Logout right beside the welcome message banner *@
            <button class="btn btn-outline-danger" @onclick="TriggerLogout" type="button" style="padding: 6px 12px;">
                Log Out
            </button>
        </div>

        <AuthorizeView Roles="Nurse" Context="nurseContext">
            <Authorized>
                <div class="mt-3">
                    <a href="/saved-records" class="btn btn-primary me-2">Go to Saved Records</a>
                </div>
            </Authorized>
        </AuthorizeView>
    </Authorized>

    <NotAuthorized>
        <div class="page-wrapper">
            <div class="modern-card">
                <h2 class="card-title">Secure Account Sign In</h2>
                <p class="card-subtitle">Please log in with your account to access, track, and manage your saved medical
                    records.</p>

                    <button class="google-signin-btn" @onclick="TriggerGoogleLogin">
                        <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" width="20"
                             alt="Google" />
                        Sign in with Google
                    </button>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated ?? false)
        {
            var roleClaim = user.FindFirst(c => c.Type == "Role")?.Value
                            ?? user.FindFirst(ClaimTypes.Role)?.Value;

            if (roleClaim == "Unassigned" || string.IsNullOrEmpty(roleClaim))
            {
                Navigation.NavigateTo("/role-selection");
            }
        }
    }

    private void TriggerGoogleLogin()
    {
        Navigation.NavigateTo(AuthUrl("login"), forceLoad: true);
    }

    private void TriggerLogout()
    {
        // FORCE LOAD ensures cookies are thoroughly purged and forces Blazor to restart on the login screen
        Navigation.NavigateTo(AuthUrl("logout"), forceLoad: true);
    }

    private string AuthUrl(string action) => HostEnvironment.IsDevelopment()
        ? $"http://localhost:5035/api/auth/{action}"
        : $"/api/auth/{action}";
}