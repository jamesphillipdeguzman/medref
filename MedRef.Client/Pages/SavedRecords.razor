@page "/saved-records"

@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http
@using MedRef.Shared.Models
@using System.Net.Http.Json

<PageTitle>Saved Records</PageTitle>

<h1>Saved Records</h1>

<p>Total Records: @records.Count</p>
<p style="color:red">@errorMessage</p>

<div class="records-table-wrapper">
	<div class="records-search-bar">
		<input type="search" class="saved-search-input" placeholder="Search Saved List"
			   aria-label="Search saved list" />
	</div>

	<div class="records-table-scroll">
		<table class="records-table table table-bordered">
			<thead>
				<tr style="background-color: #1a5276; color: #ffffff;">
					<th>CODE</th>
					<th>DISEASE NAME</th>
					<th>CUSTOM NOTES</th>
					<th>MEDLINE URL</th>
					<th>ACTIONS</th>
				</tr>
			</thead>

			<tbody>

				@foreach (var record in records)
				{
					<tr>

						<td>@record.Code</td>

						<td>@record.DiseaseName</td>

						<td>@record.Notes</td>

						<td>
							<a href="@record.MedlineUrl" target="_blank">
								@record.MedlineUrl
							</a>
						</td>

						<td>
							<div class="actions-cell">

								<button class="action-button" @onclick="() => OpenEditModal(record)">
									<span class="action-icon icon-pencil"></span>
								</button>
								<button class="action-button danger" @onclick="() => DeleteRecordAsync(record.Id)">
									<span class="action-icon icon-trash"></span>
								</button>

							</div>
						</td>

					</tr>
				}

			</tbody>

		</table>
	</div>
</div>

<div class="saved-records-footer">
	<p>App version 1.1.0</p>
	<a href="#">Apps Links Footer Footer Page More</a>
</div>

@if (showEditModal && selectedRecord is not null)
{
	<div class="modal-overlay">

		<div class="modal-container">

			<h3>Edit Notes</h3>

			<p>
				<strong>@selectedRecord.Code</strong>
			</p>

			<textarea class="notes-textarea" @bind="selectedRecord.Notes">
            </textarea>

			<div class="modal-buttons">

				<button class="save-button" @onclick="SaveRecordAsync">
					Save
				</button>

				<button class="cancel-button" @onclick="CloseEditModal">
					Cancel
				</button>

			</div>

		</div>

	</div>
}


@code {

	private string errorMessage = "";

	private List<SavedRecord> records = new();

	private SavedRecord? selectedRecord;

	private bool showEditModal = false;

	protected override async Task OnInitializedAsync()
	{
		await LoadRecordsAsync();
	}

	private async Task LoadRecordsAsync()
	{
		try
		{
			records =
				await Http.GetFromJsonAsync<List<SavedRecord>>(
					"api/saved-records")
				?? new();

			errorMessage = $"Loaded {records.Count} records";
		}
		catch (Exception ex)
		{
			errorMessage = ex.ToString();
			records = new();
		}
	}

	private void OpenEditModal(SavedRecord record)
	{
		selectedRecord = record;
		showEditModal = true;
	}

	private void CloseEditModal()
	{
		showEditModal = false;
		selectedRecord = null;
	}

	private async Task SaveRecordAsync()
	{
		if (selectedRecord is null)
			return;

		try
		{
			await Http.PutAsJsonAsync(
				$"api/saved-records/{selectedRecord.Id}",
				selectedRecord);

			await LoadRecordsAsync();

			showEditModal = false;
			selectedRecord = null;
		}
		catch
		{
		}
	}

	private async Task DeleteRecordAsync(string id)
	{
		try
		{
			await Http.DeleteAsync(
				$"api/saved-records/{id}");

			await LoadRecordsAsync();
		}
		catch
		{
		}
	}
}