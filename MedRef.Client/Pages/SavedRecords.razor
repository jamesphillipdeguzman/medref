@page "/saved-records"

@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http
@using MedRef.Shared.Models
@using System.Net.Http.Json

@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@using System.Security.Claims

@* This component displays the list of saved medical records *@
<PageTitle>Saved Records</PageTitle>

<h1>Saved Records</h1>

<p>Total Records: @records.Count</p>
<p style="color:red">@errorMessage</p>

<div class="records-table-wrapper">
	<div class="records-search-bar">
		<input type="search" class="saved-search-input" placeholder="Search Saved List" aria-label="Search saved list"
			   @bind="filterText" @bind:event="oninput" />
	</div>

	<div class="records-table-scroll">
		<table class="records-table table table-bordered">
			<thead>
				<tr style="background-color: #1a5276; color: #ffffff;">
					<th>CODE</th>
					<th>DISEASE NAME</th>
					<th>CUSTOM NOTES</th>
					<th>MEDLINE URL</th>
					<th>ACTIONS</th>
				</tr>
			</thead>

			<tbody>
				@* SKELETON LOADING STATE: Shows 4 animated skeleton rows while fetching saved records from backend *@
				@if (isLoadingRecords)
				{
					@for (int i = 0; i < 4; i++)
					{
						<tr class="skeleton-row">
							<td><span class="skeleton-text skeleton-cell"></span></td>
							<td><span class="skeleton-text skeleton-cell"></span></td>
							<td><span class="skeleton-text skeleton-cell"></span></td>
							<td><span class="skeleton-text skeleton-cell"></span></td>
							<td><span class="skeleton-text skeleton-cell skeleton-actions"></span></td>
						</tr>
					}
				}
				@* END SKELETON LOADING STATE *@
				else
				{
					@* We now loop through FilteredRecords instead of the full records list *@
					@foreach (var record in FilteredRecords)
					{
						<tr>
							<td>@record.Code</td>
							<td>@record.DiseaseName</td>
							<td>@record.Notes</td>
							<td>
								<a href="@record.MedlineUrl" target="_blank">
									@record.MedlineUrl
								</a>
							</td>
							<td>
								<div class="actions-cell">
									<button class="action-button" @onclick="() => OpenEditModal(record)">
										<span class="action-icon icon-pencil"></span>
									</button>
									<button class="action-button danger" @onclick="() => DeleteRecordAsync(record.Id)">
										<span class="action-icon icon-trash"></span>
									</button>
								</div>
							</td>
						</tr>
					}
				}
			</tbody>

		</table>
	</div>
</div>

<div class="saved-records-footer">
	<p>App version 1.1.0</p>
	<a href="https://github.com/jamesphillipdeguzman/medref" target="_blank">See this project on GitHub</a>
</div>

@if (showEditModal && selectedRecord is not null)
{
	<div class="modal-overlay">

		<div class="modal-container">

			<h3>Edit Notes</h3>

			<p>
				<strong>@selectedRecord.Code</strong>
			</p>

			<textarea class="notes-textarea" @bind="selectedRecord.Notes">
            </textarea>

			<div class="modal-buttons">

				<button class="save-button" @onclick="SaveRecordAsync">
					Save
				</button>

				<button class="cancel-button" @onclick="CloseEditModal">
					Cancel
				</button>

			</div>

		</div>

	</div>
}


@code {
	private string errorMessage = "";
	private List<SavedRecord> records = new();
	private SavedRecord? selectedRecord;
	private bool showEditModal = false;
	private bool isLoadingRecords = false;

	private string filterText = "";

	protected override async Task OnInitializedAsync()
	{
		var authState = await AuthStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;

		var roleClaim = user.FindFirst(c => c.Type == "Role")?.Value
						?? user.FindFirst(ClaimTypes.Role)?.Value;

		if (user.Identity == null || !user.Identity.IsAuthenticated || roleClaim != "Nurse")
		{
			Navigation.NavigateTo("/", forceLoad: false);
			return;
		}

		await LoadRecordsAsync();
	}

	// This property filters the 'records' list dynamically
	private IEnumerable<SavedRecord> FilteredRecords => string.IsNullOrWhiteSpace(filterText)
		? records
		: records.Where(r =>
			(r.Code?.Contains(filterText, StringComparison.OrdinalIgnoreCase) ?? false) ||
			(r.DiseaseName?.Contains(filterText, StringComparison.OrdinalIgnoreCase) ?? false));

	private async Task LoadRecordsAsync()
	{
		isLoadingRecords = true;
		try
		{
			// Ensure this URL matches your Controller route
			var response = await Http.GetAsync("api/saved-records");

			if (response.IsSuccessStatusCode)
			{
				records = await response.Content.ReadFromJsonAsync<List<SavedRecord>>() ?? new();
				errorMessage = records.Count == 0 ? "No records found." : "";
			}
			else
			{
				errorMessage = $"Error loading records: {response.StatusCode}";
			}
		}
		catch (Exception ex)
		{
			errorMessage = "Error connecting to server.";
			Console.WriteLine(ex.ToString());
		}
		finally
		{
			isLoadingRecords = false;
		}
	}

	private void OpenEditModal(SavedRecord record)
	{
		selectedRecord = record;
		showEditModal = true;
	}

	private void CloseEditModal()
	{
		showEditModal = false;
		selectedRecord = null;
	}

	private async Task SaveRecordAsync()
	{
		if (selectedRecord is null) return;

		try
		{
			// Ensure your API PUT endpoint matches this URL
			var response = await Http.PutAsJsonAsync($"api/saved-records/{selectedRecord.Id}", selectedRecord);

			if (response.IsSuccessStatusCode)
			{
				await LoadRecordsAsync();
				CloseEditModal();
			}
			else
			{
				errorMessage = "Failed to update record.";
			}
		}
		catch (Exception ex)
		{
			errorMessage = "Error connecting to server.";
			Console.WriteLine($"Detailed error: {ex.Message}");
		}
	}

	private async Task DeleteRecordAsync(string id)
	{
		try
		{
			await Http.DeleteAsync($"api/saved-records/{id}");
			await LoadRecordsAsync();
		}
		catch
		{
			errorMessage = "Error deleting record.";
		}
	}
}