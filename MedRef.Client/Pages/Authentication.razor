@page "/authentication/{action}"
@inject NavigationManager Navigation
@inject IWebAssemblyHostEnvironment HostEnvironment
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting

<div class="d-flex justify-content-center align-items-center my-5">
    <div class="text-center">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <p class="text-white">Processing security handshake, please wait...</p>
    </div>
</div>

@code {
    [Parameter] public string? Action { get; set; }

    protected override void OnParametersSet()
    {
        if (Action?.ToLower() == "login")
        {
            Navigation.NavigateTo(AuthUrl("login"), forceLoad: true);
        }
        else if (Action?.ToLower() == "logout")
        {
            Navigation.NavigateTo(AuthUrl("logout"), forceLoad: true);
        }
        else
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }
    }

    private string AuthUrl(string action) => HostEnvironment.IsDevelopment()
        ? $"http://localhost:5035/api/auth/{action}"
        : $"/api/auth/{action}";
}