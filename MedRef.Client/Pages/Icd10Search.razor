@code {
	private string searchCode = string.Empty;
	private bool isSearching = false;

	private string apiResultRaw = string.Empty;

	// These variables will replace the hardcoded strings in your markup later
    private string conditionTitle = "Type 2 diabetes mellitus without complications.";
    private string conditionDefinition = "This condition describes chronic high blood sugar caused by insulin resistance...";

	private async Task ExecuteApiSearchAsync()
    {
        // 1. Guard against empty requests
        if (string.IsNullOrWhiteSpace(searchCode))
            return;

        try
        {
            isSearching = true;
            apiResultRaw = string.Empty;

            // 2. MedlinePlus Web Service API URL configuration
            // Using the standard Web Services URL format targeting the ICD-10-CM code system
            string standardUrl = $"api/medlineproxy?code={Uri.EscapeDataString(searchCode.Trim())}";

            // 3. Issue the async HTTP network request
            var response = await Http.GetAsync(standardUrl);

            if (response.IsSuccessStatusCode)
            {
                // Read the raw JSON string payload 
                apiResultRaw = await response.Content.ReadAsStringAsync();
				                
                // TODO: Pipe 'apiResultRaw' into the data models once we create them 
                // for task #2 on Trello board.
                Console.WriteLine($"Successfully received API response payload: {apiResultRaw.Length} characters.");
				
            }
            else
            {
                conditionTitle = "Error";
                conditionDefinition = $"Failed to pull data from MedlinePlus API. Status: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            conditionTitle = "Connection Exception";
            conditionDefinition = $"An unexpected error occurred while processing the request: {ex.Message}";
        }
        finally
        {
            isSearching = false;
        }
    }

} 
