@page "/icd10-search"

// Medref ICD-10 Search Page
<PageTitle>ICD-10 Search</PageTitle>

<h1>ICD-10 Search</h1>

<div class="search-container">
	<div class="search-row">
		<input class="search-input"
			   type="text"
			   placeholder="Enter ICD-10 Code (e.g., E11.9)"
			   aria-label="ICD-10 code search"
			   autocomplete="off" />

		<button class="search-button" type="button">Search</button>
	</div>
</div>

<div class="result-parent">
	<section class="result-left">
		<div class="info-block">
			<h2>Condition:</h2>
			<p>Type 2 diabetes mellitus without complications.</p>
		</div>

		<div class="info-block">
			<h2>Definition</h2>
			<p>
				This condition describes chronic high blood sugar caused by insulin resistance.
				The patient has diabetes type 2 with no current documented complications.
			</p>
		</div>

		<div class="medline-links-box">
			<h3>Medline Plus Links:</h3>
			<p>
				Patient education resources from MedlinePlus can help explain the condition,
				symptoms, treatment options, and healthy lifestyle recommendations.
			</p>
		</div>
	</section>

	<section class="result-right">
		<h3 class="saved-codes-title">SAVED CODES</h3>

		<div class="disease-card">
			<div class="card-top">
				<span class="action-icon icon-person" aria-hidden="true"></span>
				<span class="disease-code">A10.1</span>
			</div>
			<p class="disease-name">Disease Name: Hypertension</p>
			<div class="card-actions">
				<button class="action-button" type="button">
					<span class="action-icon icon-pencil" aria-hidden="true"></span>
					Edit Notes
				</button>
				<button class="action-button danger" type="button">
					<span class="action-icon icon-trash" aria-hidden="true"></span>
					Delete
				</button>
			</div>
		</div>

		<div class="disease-card">
			<div class="card-top">
				<span class="action-icon icon-person" aria-hidden="true"></span>
				<span class="disease-code">B22.4</span>
			</div>
			<p class="disease-name">Disease Name: Asthma</p>
			<div class="card-actions">
				<button class="action-button" type="button">
					<span class="action-icon icon-pencil" aria-hidden="true"></span>
					Edit Notes
				</button>
				<button class="action-button danger" type="button">
					<span class="action-icon icon-trash" aria-hidden="true"></span>
					Delete
				</button>
			</div>
		</div>

		<div class="disease-card">
			<div class="card-top">
