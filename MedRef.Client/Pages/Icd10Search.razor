@page "/icd10-search"
@inject HttpClient Http
@using MedRef.Shared.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@inject IJSRuntime JS

@* This component provides ICD-10 code search functionality *@

<PageTitle>ICD-10 Search</PageTitle>

<h1>ICD-10 Search</h1>

<div class="search-container">
    <div class="search-row">
        <input class="search-input" 
               type="text" 
               placeholder="Enter ICD-10 Code (e.g., E11.9)"
               aria-label="ICD-10 code search" 
               autocomplete="off" 
             @bind="searchInputText"
               @bind:event="oninput"
               @onkeyup="HandleKeyUp" />

        <button class="search-button" 
                type="button"
                @onclick="ExecuteApiSearchAsync"
                disabled="@isSearching"> @(isSearching ? "Searching..." : "Search")
        </button>
    </div>
</div>

<div class="result-parent">
    <section class="result-left">
        @* State 1: active loading while waiting for the API response *@
        @if (isSearching)
        {
            <div class="info-block">
                <h2>Searching</h2>
                <p>Retrieving condition details and reference links...</p>
            </div>
            
        }
        
        @* State 2: data is available, so condition, definition, and links are displayed *@
        else if (HasSearchResult)
        {
            <div class="info-block">
                <div class="action-container">
                    <AuthorizeView>
                        <Authorized>
                            <button class="favorites-button" type="button" @onclick="SaveToFavoritesAsync">
                                SAVE TO FAVORITES ❤️
                            </button>
                            @if (!string.IsNullOrEmpty(successMessage))
                            {
                                <p style="color: green; font-size: 0.8rem; margin-top: 0.5rem;">@successMessage</p>
                            }
                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <p style="color: #dc3545; font-size: 0.8rem; margin-top: 0.5rem;">@errorMessage</p>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <p class="auth-hint">Ready to save this code?</p>
                            <a href="/login" class="favorites-button">LOGIN TO SAVE</a>
                        </NotAuthorized>
                        <Authorizing>
                            <p>Checking your session...</p>
                        </Authorizing>
                    </AuthorizeView>
                </div>
            </div>
            <div class="info-block">
                <h2>Condition:</h2>
                <p><strong>@ConditionCodeLabel</strong> - @ConditionTitle</p>
            </div>

            <div class="info-block">
                <h2>Definition</h2>
                <p>@((MarkupString)ConditionDefinitionHtml)</p>
            </div>

            <div class="medline-links-box">
                <h3>Medline Plus Links:</h3>
                <p>Patient education resources from MedlinePlus:</p>
                @* If the record includes valid links, list them; otherwise show a fallback *@
                @if (ConditionLinks.Any())
                {
                    <ul class="medline-links-list">
                        @foreach (var link in ConditionLinks)
                        {
                            <li class="medline-links-item">
                                <a href="@link.Href" target="_blank" rel="noopener noreferrer">
                                    @GetLinkLabel(link)
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>No links are available for this condition.</p>
                }
            </div>

            
        }
        @* State 3: the API returned an error or an exception occurred *@
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="info-block error-state" style="border-left: 4px solid #dc3545; padding-left: 15px;">
                <h2>System Alert</h2>
                <p style="color: #dc3545;">@errorMessage</p>
            </div>
        }
        else
        {
            @* State 4: initial view before any search is performed *@
            <div class="info-block empty-state">
                <h2>No Active Search</h2>
                <p>Please type an explicit diagnostic lookup value above (e.g., <code>E11.9</code>) to explore unified clinical index definitions.</p>
            </div>
        }
    </section>
    
    <AuthorizeView>
    <Authorized>
        <section class="result-right">
            <h3 class="saved-codes-title">SAVED CODES</h3>

            @if (userSavedRecords != null && userSavedRecords.Any())
            {
                @foreach (var record in userSavedRecords)
                {
                    <div class="disease-card" 
                         @onclick="() => LoadCodeIntoSearch(record.Code)" 
                         style="cursor: pointer;">
                        <div class="card-top">
                            <span class="action-icon icon-person"></span>
                            <span class="disease-code">@record.Code</span>
                        </div>
                        <p class="disease-name">@record.DiseaseName</p>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No saved codes yet.</p>
            }
        </section>
    </Authorized>
</AuthorizeView>
</div>

@code {
    private string searchInputText = string.Empty;
    private string searchCode = string.Empty;
    private bool isSearching = false;
    private string errorMessage = string.Empty;

    private string? successMessage;

    private string SearchQuery = "";
    private List<SavedRecord> allRecords = new();
    private string filterText = "";
    private List<SavedRecord> userSavedRecords = new();
            
    
    // Strongly typed model holds the deserialized structure live
    private MedlineRoot? searchResult;

    // Indicates whether at least one entry was returned by Medline
    private bool HasSearchResult => searchResult?.Feed?.Entries?.Any() == true;

    // Selects the first entry as the primary result displayed in the UI
    private MedlineEntry? PrimaryEntry => searchResult?.Feed?.Entries?.FirstOrDefault();

    // Normalizes the searched code so it is displayed consistently on screen
    private string ConditionCodeLabel => string.IsNullOrWhiteSpace(searchCode)
        ? "Unknown"
        : searchCode.ToUpperInvariant().Trim();

    // Condition title with fallback when the API does not return one
    private string ConditionTitle => string.IsNullOrWhiteSpace(PrimaryEntry?.Title?.Value)
        ? "Condition title unavailable"
        : PrimaryEntry.Title.Value;

    // Definition with HTML fallback to preserve summary formatting
    private string ConditionDefinitionHtml => string.IsNullOrWhiteSpace(PrimaryEntry?.Summary?.Value)
        ? "<em>No definition is available for this condition.</em>"
        : PrimaryEntry.Summary.Value;

    // Filters out links without URLs to avoid broken anchors in the UI
    private IReadOnlyList<MedlineLink> ConditionLinks =>
        PrimaryEntry?.Links?.Where(link => !string.IsNullOrWhiteSpace(link.Href)).ToList()
        ?? new List<MedlineLink>();

    private async Task ExecuteApiSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(searchInputText)) return;

        isSearching = true;
        errorMessage = string.Empty;
        searchResult = null;

        // Sync input to the search query variable
        SearchQuery = searchInputText.Trim();
        searchCode = SearchQuery;

        // Call the unified search method
        await PerformSearch();

        if (searchResult?.Feed?.Entries == null || !searchResult.Feed.Entries.Any())
        {
            errorMessage = $"No unified clinical matching records returned for index entry: {searchCode}";
        }

        isSearching = false;

        await JS.InvokeVoidAsync("localStorage.setItem", "lastSearchTerm", searchInputText);
    }
    

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        // Let users just press 'Enter' inside the box instead of clicking search every time
        if (e.Key == "Enter")
        {
            await ExecuteApiSearchAsync();
        }
    }

    private async Task HandleSave(SavedRecord selectedCode)
    {
        var newRecord = new SavedRecord { 
            Code = selectedCode.Code, 
            DiseaseName = selectedCode.DiseaseName 
        };

        var response = await Http.PostAsJsonAsync("api/saved-records", newRecord);

        if (response.IsSuccessStatusCode)
        {
            successMessage = "Successfully saved! ❤️";
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            errorMessage = "This code is already in your favorites list!";
        }
    }

    private static string GetLinkLabel(MedlineLink link)
    {
        // Builds a user-friendly label and uses a fallback when "rel" is missing
        if (string.IsNullOrWhiteSpace(link.Rel))
            return "View Official Reference Document";

        return $"View Official Reference Document ({link.Rel})";
    }

    // This property automatically filters the list whenever filterText changes
    private IEnumerable<SavedRecord> FilteredRecords => string.IsNullOrWhiteSpace(filterText)
        ? allRecords
        : allRecords.Where(r => r.Code.Contains(filterText, StringComparison.OrdinalIgnoreCase) || 
                                r.DiseaseName.Contains(filterText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        // Simply load the data; the AuthenticationStateProvider 
        // will have already resolved by the time this runs.
        await LoadSavedRecordsAsync();
        // Load your data once
        allRecords = await Http.GetFromJsonAsync<List<SavedRecord>>("api/saved-records") ?? new();
            // Try to load the previous search term from browser memory
        searchInputText = await JS.InvokeAsync<string>("localStorage.getItem", "lastSearchTerm") ?? string.Empty;
        if (!string.IsNullOrEmpty(searchInputText)) 
        {
            await LoadCodeIntoSearch(searchInputText);
        }
    }

    private async Task LoadSavedRecordsAsync()
    {
        // Fetches the data from your existing GET endpoint
        userSavedRecords = await Http.GetFromJsonAsync<List<SavedRecord>>("api/saved-records") 
                        ?? new List<SavedRecord>();
    }

    private async Task SaveToFavoritesAsync()
    {
        if (PrimaryEntry == null) return;
        // Ensure you have the right claim type. 
        // Often, NameIdentifier is correct, but sometimes you need "sub" or "email"
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
             

        var user = authState.User;

        // Use this to debug: Print all claims to the browser console
        foreach(var claim in user.Claims) {
            Console.WriteLine($"Claim Type: {claim.Type}, Value: {claim.Value}");
        }

        // Ensure you are pulling the right claim type that uniquely identifies the user
        var userId = user.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value 
                    ?? user.FindFirst("sub")?.Value; // 'sub' is standard for OIDC/Google
                

        var newRecord = new SavedRecord
        {   
            // If userId is null, default to "Unknown" or handle it as an error
            UserId = userId ?? "anonymous",
            Code = ConditionCodeLabel,
            DiseaseName = ConditionTitle,
            Notes = "Saved from search",
            // Save medline url
            MedlineUrl = ConditionLinks.FirstOrDefault()?.Href ?? string.Empty
        };
        

        try 
        {
            var response = await Http.PostAsJsonAsync("api/saved-records", newRecord);
            
            if (response.IsSuccessStatusCode)
            {
                successMessage = "Successfully saved to favorites! ❤️";
                errorMessage = string.Empty;
                await LoadSavedRecordsAsync(); 
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                // This catches the 'Conflict' returned by your controller
                errorMessage = "This code is already in your favorites list!";
                successMessage = string.Empty;
            }
            else
            {
                errorMessage = "Failed to save record to the database.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving: {ex.Message}";
        }
    }

    private async Task DeleteRecordAsync(string id)
    {
        var response = await Http.DeleteAsync($"api/saved-records/{id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadSavedRecordsAsync(); // This triggers the UI refresh
        }
        else
        {
            errorMessage = "Failed to delete the record.";
        }
    }

    
    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(SearchQuery)) return;

        try
        {
            // This is the only place the API call happens
            string endpointUrl = $"api/medlineproxy?code={Uri.EscapeDataString(SearchQuery)}";
            searchResult = await Http.GetFromJsonAsync<MedlineRoot>(endpointUrl);
        }
        catch (Exception ex)
        {
            errorMessage = $"Search error: {ex.Message}";
            Console.WriteLine(errorMessage);
        }
    }

    private async Task LoadCodeIntoSearch(string code)
    {
        // 1. Update the local variables
        SearchQuery = code;
        searchInputText = code;
        searchCode = code;
        
        // 2. Perform the search
        await PerformSearch();
        
        // 3. PERSIST THE STATE: Save this code to localStorage 
        // so it persists across page navigations/refreshes
        await JS.InvokeVoidAsync("localStorage.setItem", "lastSearchTerm", code);
        
        // 4. Update the UI
        StateHasChanged();
    }

      
    
}